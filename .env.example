# ===========================================
# Fichier .env — Variables d'environnement
# ===========================================
# Remplis les valeurs ci-dessous avec tes propres clés.
# ⚠️  Ce fichier ne doit JAMAIS être commit sur git (voir .gitignore).
# Renomme ce fichier en ".env" (sans l'extension .example) une fois rempli.


# --- OpenWeatherMap ---
# Clé obtenue sur https://openweathermap.org/api (gratuit, ~10 min d'activation)
OWM_API_KEY=colle_ta_cle_ici


# --- AWS (pour la partie stockage S3, à venir) ---
# Identifiants obtenus dans la console AWS IAM
AWS_ACCESS_KEY_ID=colle_ton_access_key_ici
AWS_SECRET_ACCESS_KEY=colle_ta_secret_key_ici
AWS_DEFAULT_REGION=eu-west-3
S3_BUCKET_NAME=kayak-project-ton-nom


# --- Base de données SQL (pour la partie stockage SQL, à venir) ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Pour prototyper en local avec SQLite, utilise à la place : sqlite:///data/kayak.db
DATABASE_URL=sqlite:///data/kayak.db
